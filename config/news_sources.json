    "article_url_patterns": [
      "/tamil-nadu/.*",
      "/all-editions/.*"
    ],
    "pagination_rules": {
      "param_name": "p",
      "page_step": 1,
      "max_pages": 5,
      "url_template": "https://www.dinamani.com/all-editions/tamil-nadu?p={page}"
    },
    "parser_type": "dinamani_adapter",
    "rate_limit": 2.0,
    "enabled": true,
    "access_notes": "Open web regional Tamil portal; standard 2.0s delay.",
    "rss_urls": [
      "https://www.dinamani.com/all-editions/tamil-nadu/rss.xml"
    ],
    "selectors": {
      "title": "h1.story-heading, h1.article-headline",
      "body": "div.story-content p, div.article-detail p",
      "author": "span.author-name",
      "date": "meta[property='article:published_time']"
    }
  },
  {
    "source_id": "src_dinamalar_ta",
    "source_name": "Dinamalar",
    "domain": "dinamalar.com",
    "language": "ta",
    "article_url_patterns": [
      "/news_detail.asp\\?id=.*",
      "/news/.*"
    ],
    "pagination_rules": {
      "param_name": "page",
      "page_step": 1,
