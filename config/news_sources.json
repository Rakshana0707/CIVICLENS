      "url_template": "https://www.dinamalar.com/news.asp?page={page}"
    },
    "parser_type": "dinamalar_adapter",
    "rate_limit": 3.0,
    "enabled": true,
    "access_notes": "Respect epaper paywalls; parse public text articles with 3.0s delay.",
    "rss_urls": [
      "https://www.dinamalar.com/rss/tn_news.xml"
    ],
    "selectors": {
      "title": "h1.newsdetailhead, h1",
