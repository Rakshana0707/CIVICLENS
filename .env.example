# CivicLens TN - Environment Configuration Example

# Application Info
APP_NAME="CivicLens TN"
ENV="development"
DEBUG=True

# API Configuration
API_HOST="0.0.0.0"
API_PORT=5000
FRONTEND_URL="http://localhost:3000"

# Database Configuration
DATABASE_URL="sqlite:///data/processed/civiclens.db"

# Directory Configuration
DATA_DIR="data"
RAW_DATA_DIR="data/raw"
PROCESSED_DATA_DIR="data/processed"
MODEL_DIR="ml/models"

# Logging Configuration
LOG_LEVEL="INFO"
